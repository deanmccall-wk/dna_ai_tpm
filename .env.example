# Jira Data Center (required for all triage operations)
# Generate at: Jira profile > Personal Access Tokens > Create token
JIRA_BASE_URL=https://jira.atl.workiva.net
JIRA_PAT=your-jira-personal-access-token

# Confluence Data Center (required for runbook publishing only)
# Generate at: Confluence profile > Personal Access Tokens > Create token
# Note: Confluence is a separate host from Jira and may need a separate token
CONFLUENCE_BASE_URL=https://wiki.atl.workiva.net
CONFLUENCE_PAT=your-confluence-personal-access-token

# Redshift (optional -- only needed for deletion/verify_deletion.py)
REDSHIFT_HOST=redshift.it.workiva.net
REDSHIFT_PORT=5439
REDSHIFT_DB=defaultdb
REDSHIFT_USER=your-redshift-username
REDSHIFT_PASSWORD=your-redshift-password

# Atlan (required for asset lookup during triage)
# Get from your Atlan admin or generate at: Atlan > Settings > API Keys
ATLAN_BASE_URL=https://workiva.atlan.com
ATLAN_API_TOKEN=your-atlan-api-token

# GitHub (optional -- for code/PR search during triage)
# Generate at: GitHub > Settings > Developer settings > Personal access tokens
# Needs: repo scope (for private repo code search)
GITHUB_PAT=your-github-personal-access-token
GITHUB_ORG=Workiva
